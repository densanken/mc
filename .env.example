# openssl rand -base64 32
RCON_PASSWORD=

# Minecraft と backups を実行する host user の UID/GID
MINECRAFT_UID=1000
MINECRAFT_GID=1000

# host 上のバックアップ保存先
# 空のままなら既定値 $HOME/mc-backups を使用します
# 別の場所に保存する場合だけ絶対パスを設定する
BACKUP_ROOT=

# Discord Developer Portal で発行した Bot token
DISCORDSRV_TOKEN=

# playit dashboard で Docker agent 用に発行する secret key
PLAYIT_SECRET_KEY=
