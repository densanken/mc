# 接続を許可する Discord Guild ID
# 複数指定時はいずれか一つへの所属を要求します
# ID はカンマ区切りで指定し、空白は入れないこと
DISCORD_REQUIRED_GUILD_IDS=

# Minecraft の global chat と連携する Discord Channel ID
DISCORD_CHAT_CHANNEL_ID=

# Minecraft アカウントとの連携時に自動付与する Discord Role ID
# 設定しない場合は自動付与を無効にします
DISCORD_LINKED_ROLE_ID=

# 追加で要求する Discord Role ID
# 空なら Role を参加条件にしません
# 複数指定時はカンマ区切りにしてください
DISCORD_REQUIRED_ROLE_IDS=

# true は上記の Role すべて、false はいずれか一つを要求する
DISCORD_REQUIRE_ALL_ROLES=false
